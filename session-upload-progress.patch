@@ -0,0 +1,169 @@
+--TEST--
+Session upload progress keeps igbinary session objects as __PHP_Incomplete_Class and runs no user code
+--SKIPIF--
+<?php
+if (!extension_loaded('session')) die('skip session extension not loaded');
+if (PHP_VERSION_ID < 80200) die('skip needs PHP 8.2 or later');
+if (!getenv('TEST_PHP_CGI_EXECUTABLE')) die('skip CGI not available');
+if (@ini_set('session.serialize_handler', 'igbinary') === false) die('skip igbinary session serializer not available');
+?>
+--INI--
+error_reporting=E_ALL & ~E_DEPRECATED
+--FILE--
+<?php
+/* php_session_rfc1867_update() decodes and writes back the session before RINIT
+ * (GHSA-w8hw-w9fx-j79w). No class may be looked up then: unserialize_callback_func
+ * would run, Serializable payloads could not be kept, and data carrying the
+ * incomplete class bookkeeping member could change class. */
+ob_start();
+
+class W { public $a = 1; public $woke = 0; function __wakeup() { $this->woke++; } }
+class Cust implements Serializable {
+    public $x = 'payload';
+    function serialize() { return $this->x; }
+    function unserialize($d) { $this->x = $d; }
+}
+class L {
+    public $p, $q;
+    function __construct($p = null, $q = null) { $this->p = $p; $this->q = $q; }
+    function __serialize(): array { return [$this->p, $this->q]; }
+    function __unserialize(array $d): void { [$this->p, $this->q] = [$d[0], $d[1]]; }
+}
+enum Suit: string { case Hearts = 'H'; }
+
+$dir = __DIR__ . '/igbinary_session_upload_progress';
+@mkdir($dir);
+$worker = "$dir/worker.php";
+file_put_contents($worker, '<?php');
+
+ini_set('session.save_path', $dir);
+ini_set('session.use_cookies', '0');
+ini_set('session.cache_limiter', '');
+ini_set('session.serialize_handler', 'igbinary');
+
+function read_record($sid) {
+    session_id($sid);
+    session_start();
+    unset($_SESSION['upload_progress_key']);
+    $s = serialize($_SESSION);
+    session_abort();
+    return $s;
+}
+
+$shared = new W;
+$self = new stdClass;
+$self->self = $self;
+$self->{'0'} = 'zero';
+$storage = new SplObjectStorage;
+$storage[$shared] = 'data';
+$array = ['k' => 1];
+session_id('mixed');
+session_start();
+$_SESSION = [
+    'w' => $shared, 'w2' => $shared,
+    'c' => new Cust, 'l' => new L(10, [20, 30]),
+    'ao' => new ArrayObject([5 => 'five', 'k' => 'v']),
+    'dt' => new DateTime('2026-10-22 12:00:00', new DateTimeZone('UTC')),
+    'e1' => Suit::Hearts, 'e2' => Suit::Hearts, 'st' => $storage, 'self' => $self,
+];
+$_SESSION['r1'] = &$array;
+$_SESSION['r2'] = &$array;
+session_write_close();
+
+$reserved = new stdClass;
+$reserved->{'__PHP_Incomplete_Class_Name'} = 'W';
+session_id('reserved');
+session_start();
+$_SESSION['x'] = $reserved;
+session_write_close();
+
+$before = read_record('mixed');
+
+/* php-cgi is started with -n, so the shared session and igbinary modules have to be named again. */
+$cmd = [getenv('TEST_PHP_CGI_EXECUTABLE'), '-n', '-q'];
+foreach (['session', 'igbinary'] as $ext) {
+    foreach ([ini_get('extension_dir'), PHP_EXTENSION_DIR] as $extdir) {
+        if (file_exists("$extdir/$ext." . PHP_SHLIB_SUFFIX)) {
+            array_push($cmd, '-d', "extension=$extdir/$ext." . PHP_SHLIB_SUFFIX);
+            break;
+        }
+    }
+}
